# Local, git-ignored settings (copy to .env). Never commit real values.

# ebusd connection (optional, for local scripts)
EBUSD_HOST=192.168.1.100
EBUSD_PORT=8888

# Home Assistant host for tools/deploy_ha.py (SSH add-on user with passwordless sudo)
HA_HOST=192.168.1.100
HA_SSH_USER=user
HA_SSH_PASSWORD=your_password_here
# HA_SSH_PORT=22
